[
  {"identifier": "2-chloro-6-(methylsulfonyl)toluene", "source_lines": [182, 185, 187, 197], "quote_zh": "1、2-氯-6-甲磺酰基甲苯的合成 ... 浓缩得淡黄的固体28.6g,收率84％。 ... 加入2-氯-6-甲磺酰基甲苯34.0g(0.2mol)"},
  {"identifier": "2-chlorotoluene", "source_lines": [187], "quote_zh": "加入2-氯甲苯25.3g(0.2mol)"},
