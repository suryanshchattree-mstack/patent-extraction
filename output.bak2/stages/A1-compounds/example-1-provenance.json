  {"identifier": "1,2-dichloroethane", "source_lines": [187], "quote_zh": "和1,2-二氯乙烷150ml"},
  {"identifier": "methanesulfonyl chloride", "source_lines": [187], "quote_zh": "然后滴加甲磺酰氯25.25g(0.22mol)"},
