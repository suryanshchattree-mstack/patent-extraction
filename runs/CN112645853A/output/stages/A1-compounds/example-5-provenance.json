  {
    "identifier": "potassium 2-chloro-3-(bromomethyl)-4-(methanesulfonyl)benzoate",
    "source_lines": [356, 358, 363, 370],
    "quote_zh": "液相色谱中控2-氯-3-溴甲基-4-甲磺酰基苯甲酸钾盐归一含量为98.3％"
  },
  {
    "identifier": "2,2,2-trifluoroethanol",
    "source_lines": [365],
    "quote_zh": "向反应釜中加入150mL三氟乙醇，开动搅拌"
  },
  {
    "identifier": "potassium hydride",
    "source_lines": [365],
    "quote_zh": "室温下投入20g氢化钾(30％，0.15mol)，搅拌至溶解完全"
  },
  {
    "identifier": "potassium 2,2,2-trifluoroethoxide",
    "source_lines": [363, 365, 370],
    "quote_zh": "经脱溶后得到三氟乙醇醇钾固体，密封备用"
  },
  {
    "identifier": "tetrahydrofuran",
    "source_lines": [370],
    "quote_zh": "向三氟乙醇醇钾中加入200mL  THF，搅拌溶解后控制釜温在5℃"
  },
  {
